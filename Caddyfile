your-domain.com {
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	# Site-wide so responses Caddy serves itself (the /api/v1/* API and the
	# /binaries/* file server, which hands executables to volunteers) refuse
	# content-type sniffing. The dashboard sets the same value app-side; the
	# double-set is harmless.
	header X-Content-Type-Options nosniff

	# gRPC — detect via content-type, proxy to infrastructure over h2c.
	# Horizontal scale-out: use a dynamic A-record upstream so Caddy re-resolves
	# the `infrastructure` service DNS and fans out across ALL replica IPs
	# (a bare `reverse_proxy infrastructure:9090` resolves once and can pin to a
	# single replica). round_robin spreads volunteer gRPC across every head, so
	# scaling HEAD_REPLICAS needs no Caddyfile edit.
	@grpc header Content-Type application/grpc*
	handle @grpc {
		# Per-request body ceiling: every volunteer RPC is unary, and the head's
		# own gRPC transport cap is 128MB (grpcMaxMsgSize, sized for 100MB
		# checkpoint/result messages plus framing), so 132MB never truncates a
		# legitimate call while stopping unbounded streams at the proxy.
		request_body {
			max_size 132MB
		}
		reverse_proxy {
			dynamic a {
				name infrastructure
				port 9090
			}
			transport http {
				versions h2c
			}
			lb_policy round_robin
			# Dial-retry budget only — passive health ejection (fail_duration/
			# max_fails) is deliberately ABSENT. Caddy counts any mid-stream
			# proxy error as an upstream failure, including a client-caused
			# request_body cap trip (gRPC is always length-less, so an over-cap
			# message trips the cap only while streaming to the upstream), and
			# offers no way to exclude client-caused failures from that
			# accounting. With ejection enabled, one such request pulls the
			# replica from rotation and answers every gRPC call 503 for the
			# fail_duration window — on a one-replica deploy, a full anonymous
			# denial of service. Failover instead rides the dial-retry budget
			# below: a connection-refused attempt retries (and with >1 replica
			# lands on another IP via round_robin) before the client sees an
			# error. Caddy's ACTIVE health checks (health_uri) do not run for
			# dynamic upstreams — configuring them here would validate and
			# silently do nothing.
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	# Docker registry — anonymous pull, authenticated push/delete.
	# The version-check ping (GET /v2/) is ALSO credential-gated: docker, podman,
	# and skopeo probe it before any operation and only attach credentials when
	# the ping answers 401 with a WWW-Authenticate challenge. A 200-with-no-
	# challenge ping makes every client push anonymously and fail mid-upload
	# with "authentication required" even when the stored password is correct —
	# and lets `podman login` "succeed" against any password. Gating the ping
	# restores the standard registry auth handshake; pulls stay anonymous
	# (GET/HEAD on /v2/<name>/... paths are matched by neither gate).
	handle /v2/* {
		@registry_write method PUT PATCH POST DELETE
		@registry_ping path /v2/
		basic_auth @registry_write {
			{$REGISTRY_USER} {$REGISTRY_PASS_HASH}
		}
		basic_auth @registry_ping {
			{$REGISTRY_USER} {$REGISTRY_PASS_HASH}
		}
		reverse_proxy registry:5000
	}

	handle /binaries/* {
		root * /srv
		file_server
	}

	# REST API — plain HTTP to infrastructure (Caddy terminates TLS).
	# Dynamic A-record upstream + round_robin so the REST API fans out across all
	# head replicas the same way the gRPC block does. Caddy forwards the real
	# client IP in X-Forwarded-For; set LETTUCE_TRUSTED_PROXIES (already wired in
	# compose.production.yaml) so the head buckets per real client, not per proxy.
	handle /api/v1/* {
		# Per-request body ceilings. The general 64MB ceiling covers the
		# API-key owner routes, which have no head-side cap — the largest of
		# them, bulk work-unit upload, already tells callers to split oversized
		# batches into multiple requests. The registry (/v2/*) and dashboard
		# handles are deliberately uncapped here: image pushes are multi-GB
		# (and write-gated by basic_auth), and the dashboard enforces its own
		# framework body limits.
		#
		# Routes where the head enforces a SMALLER body cap of its own must be
		# capped at the proxy, at or below the head's value: an oversized body
		# that reaches the head instead makes the head reset the connection
		# mid-upload, so the client sees a 502 (not the correct 413) and the
		# over-cap bytes cross the proxy->head hop for nothing.
		#
		# The caps are enforced in two layers. The @oversized_* guards reject
		# an over-limit request UP FRONT (413, upstream never contacted)
		# whenever the declared Content-Length or a length-less body-bearing
		# method gives it away; the request_body directives are a hard-cap
		# BACKSTOP that Caddy (v2.11) enforces only WHILE STREAMING to the
		# upstream, bounding the bytes any request can push no matter how it
		# is encoded. Caddy counts that mid-stream trip as an upstream failure
		# (the client still gets a 413, but there is no per-status or per-cause
		# passive-health filter to exclude it), which is why this reverse_proxy
		# runs with NO passive health ejection — no fail_duration/max_fails,
		# matching the gRPC block above. With ejection enabled, any request
		# that reached the backstop pulled the sole replica from rotation and
		# answered ALL /api/v1/* traffic 503 for fail_duration (the PB-20
		# family); rounds of widening the guards kept closing individual
		# bypasses without ever making the guard set provably complete. With
		# ejection off, a backstop trip costs exactly the offending request,
		# so the guards below are an optimization (clean 413, no bytes
		# streamed toward the head) rather than a completeness obligation.
		#
		# For a guard to cover exactly what its backstop covers, it selects the
		# route with the SAME case-insensitive `path` matcher the request_body
		# pair uses. (An earlier revision compared {path} with a case-SENSITIVE
		# CEL ==/startsWith, so POST /api/v1/attestations/VERIFY skipped the
		# guard, fell onto the backstop, and ejected the replica — PB-20b.) The
		# length expression rejects a request that EITHER declares an over-cap
		# Content-Length (any method) OR declares no length at all on a body-
		# bearing method — a length-less/chunked upload, whose real size Caddy
		# cannot know up front (the PB-20 chunked residual: without this arm a
		# single chunked POST tripped the backstop and ejected the replica).
		# GET/HEAD/OPTIONS are exempt from the length-less arm so an empty
		# request (including a CORS preflight) still passes. The general ceiling
		# omits the length-less arm entirely: bodiless owner POSTs (.../activate,
		# .../pause, …) are a documented curl flow that legitimately sends no
		# Content-Length, so a chunked >64MB body to an owner route is the one
		# residual the backstop still catches (bytes bounded, and with
		# ejection off the trip costs nothing beyond that request).
		#
		# CONTRACT: any head-side body cap below the 64MB default MUST be
		# mirrored here — an @oversized_* guard AND a request_body pair, keyed
		# off the same path, at the same value or lower. Verified head caps:
		#   attestation/handler.go verifyMaxBody         = 1 KiB
		#       → POST /api/v1/attestations/verify
		#   browser-volunteer-handlers.go browserRegisterMaxBody = 64 KiB
		#       → POST /api/v1/volunteers/register, .../register-challenge
		#   ed25519_auth.go ed25519MaxBodySize           = 10 MiB (every
		#       Ed25519-signed REST body): /api/v1/volunteers/* (request-work,
		#       submit-result) AND /api/v1/identity/bind-did — the latter lives
		#       outside /api/v1/volunteers/* and was previously unmirrored (PB-20c).
		@oversized_verify {
			path /api/v1/attestations/verify
			expression `({http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1024) || (!({http.request.method} in ["GET","HEAD","OPTIONS"]) && {http.request.header.Content-Length} == "")`
		}
		error @oversized_verify 413
		@oversized_register {
			path /api/v1/volunteers/register /api/v1/volunteers/register-challenge
			expression `({http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 65536) || (!({http.request.method} in ["GET","HEAD","OPTIONS"]) && {http.request.header.Content-Length} == "")`
		}
		error @oversized_register 413
		@oversized_signed {
			path /api/v1/volunteers/* /api/v1/identity/bind-did
			expression `({http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 10485760) || (!({http.request.method} in ["GET","HEAD","OPTIONS"]) && {http.request.header.Content-Length} == "")`
		}
		error @oversized_signed 413
		@oversized_any expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 64000000`
		error @oversized_any 413

		@attestation_verify path /api/v1/attestations/verify
		request_body @attestation_verify {
			max_size 1KiB
		}
		@volunteer_register path /api/v1/volunteers/register /api/v1/volunteers/register-challenge
		request_body @volunteer_register {
			max_size 64KiB
		}
		# Every Ed25519-signed REST body (10 MiB head cap): the volunteer routes
		# AND /api/v1/identity/bind-did, which lives outside /api/v1/volunteers/*.
		@signed_routes path /api/v1/volunteers/* /api/v1/identity/bind-did
		request_body @signed_routes {
			max_size 10MiB
		}
		request_body {
			max_size 64MB
		}
		reverse_proxy {
			dynamic a {
				name infrastructure
				port 8080
			}
			lb_policy round_robin
			# Dial-retry budget only — passive health ejection deliberately
			# absent, matching the gRPC block above (see the note there; the
			# body-cap comment above explains why ejection turned one client
			# request into a fail_duration-long outage on this route).
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy dashboard:3000
	}
}

# Viz bundle subdomain — serves viz content in a separate origin for iframe isolation
viz.your-domain.com {
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	header Content-Security-Policy "frame-ancestors https://your-domain.com"
	header X-Content-Type-Options nosniff
	reverse_proxy dashboard:3000
}

# HTTP to HTTPS redirect
http://your-domain.com {
	redir https://{host}{uri} permanent
}

http://viz.your-domain.com {
	redir https://{host}{uri} permanent
}
