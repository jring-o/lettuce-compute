release-*/
*.msi
*.msi.sha256
/lettuce-volunteer
/lettuce-volunteer-linux-amd64
/lettuce-volunteer-windows-amd64
/lettuce-volunteer-darwin-amd64
/lettuce-volunteer-darwin-arm64

