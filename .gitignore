*.wasm
*-linux
*-linux-amd64
*-linux-arm64
*-darwin-amd64
*-darwin-arm64
*-windows-amd64
/services/infrastructure/lettuce-head
/services/infrastructure/lettuce-server

# Environment and secrets
.env
.env.local
.env*.local
*.pem
*.key
*.p12
*.pfx
id_rsa*

# Runtime secret/artifact dirs (bind-mounted by compose.production.yaml) — keep dir, drop contents
keys/*
!keys/.gitkeep
binaries/*
!binaries/.gitkeep

# Test and coverage
coverage/
coverage.out
*.test

# Python (container examples)
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Desktop app (apps/volunteer-desktop) build inputs that are produced, not authored:
# the bundled volunteer-client sidecar for every platform (scripts/build-sidecar.*),
# the downloaded Podman installer (scripts/fetch-podman-installer.ps1), and the
# schema files the Tauri CLI generates next to the capability definitions.
apps/volunteer-desktop/src-tauri/binaries/*
apps/volunteer-desktop/src-tauri/resources/*.msi
apps/volunteer-desktop/src-tauri/gen/

# OS
.DS_Store
Thumbs.db

# Internal docs (audits, operator notes, trackers) — kept locally, not for the public repo.
